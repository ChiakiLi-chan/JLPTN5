# These are provided automatically by Vercel once you connect a Redis
# database to this project (Storage tab). For local dev, don't fill these
# in by hand — run `vercel env pull .env.development.local` instead, which
# pulls the real values from your linked Vercel project.

KV_REST_API_URL=
KV_REST_API_TOKEN=
# or, depending on which Redis integration you used:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
